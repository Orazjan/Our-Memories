<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background_light">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Редактировать"
        android:background="@drawable/selector_chip_category"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEditTitle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Название"
        android:inputType="textCapSentences"
        android:background="@drawable/bg_input_soft"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:layout_marginBottom="12dp"/>

    <!-- Выбор даты (стилизован под инпут) -->
    <TextView
        android:id="@+id/tvEditDate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_soft"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="20.05.2024"
        android:drawableTint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etEditDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:hint="Описание"
        android:inputType="textCapSentences|textMultiLine"
        android:gravity="top"
        android:background="@drawable/bg_input_soft"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:layout_marginBottom="14dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Кнопка Отмена (Серый текст/прозрачный фон) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_border_selected"
            android:text="Отмена"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <View android:layout_width="16dp" android:layout_height="0dp"/>

        <!-- Кнопка Добавить (Розовый фон) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="@color/baby_pink"
            android:text="Добавить"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="16sp"/>

    </LinearLayout>
</LinearLayout>


