<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Новое желание"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Чего хочется?"
        android:inputType="textCapSentences"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"/>

    <!-- Выбор категории -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Категория"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <RadioGroup
            android:id="@+id/rgCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="✨ Разное"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/catMovie"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="🎬 Кино"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/catFood"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="🍔 Еда"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/catShopping"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="🛒 Купить"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/catTravel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="✈️ Поездка"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/catDate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="❤️ Свидание"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

        </RadioGroup>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/etDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:hint="Детали (необязательно)"
        android:inputType="textCapSentences|textMultiLine"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"/>

</LinearLayout>