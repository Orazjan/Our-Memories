<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Новое желание"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Чего хочется?"
        android:inputType="textCapSentences"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Категория"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_marginBottom="16dp">

        <RadioGroup
            android:id="@+id/rgCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/catOther"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="✨ Разное"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/catMovie"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="🎬 Кино"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/catFood"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="🍔 Еда"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/catShopping"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="🛒 Купить"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/catTravel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="✈️ Поездка"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/catDate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/selector_chip_category"
                android:button="@null"
                android:text="❤️ Свидание"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"/>

        </RadioGroup>
    </HorizontalScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Описание"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:gravity="top|start"
        android:hint="Детали (необязательно)"
        android:inputType="textCapSentences|textMultiLine"
        android:background="@drawable/bg_input_field"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_border_selected"
            android:text="Отмена"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <View android:layout_width="16dp" android:layout_height="0dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="@color/baby_pink"
            android:text="Добавить"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="16sp"/>

    </LinearLayout>

</LinearLayout>