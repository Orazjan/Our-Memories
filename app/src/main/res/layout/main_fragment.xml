<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- === 1. Top Bar === -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_light"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- === 2. Scrollable Content === -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- === КАРТОЧКА ПАРЫ === -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCoupleStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/baby_pink"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <!-- Счетчик дней -->
                        <TextView
                            android:id="@+id/tvDaysCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/tiktokshrift"
                            android:text="0"
                            android:textColor="@color/heart_red"
                            android:textSize="48sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvDaysLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/tiktokshrift"
                            android:text="@string/days_together"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDaysCount" />

                        <!-- === СЕРДЦЕ (Центральный якорь) === -->
                        <TextView
                            android:id="@+id/tvHeartIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="50dp"
                            android:text="❤️"
                            android:textSize="40sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDaysLabel"
                            app:tint="@color/heart_red" />

                        <!-- === ЛЕВЫЙ ПОЛЬЗОВАТЕЛЬ (Я) === -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardMyAvatar"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="16dp"
                            app:cardBackgroundColor="@android:color/white"
                            app:cardCornerRadius="40dp"
                            app:cardElevation="2dp"
                            app:layout_constraintBottom_toBottomOf="@id/tvHeartIcon"
                            app:layout_constraintEnd_toStartOf="@id/tvHeartIcon"
                            app:layout_constraintTop_toTopOf="@id/tvHeartIcon">

                            <ImageView
                                android:id="@+id/ivMyAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                tools:src="@tools:sample/avatars" />
                        </androidx.cardview.widget.CardView>

                        <!-- Мой Статус (Пузырек) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardMyStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="-4dp"
                            android:layout_marginBottom="-4dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="6dp"
                            app:contentPadding="4dp"
                            app:layout_constraintBottom_toTopOf="@id/cardMyAvatar"
                            app:layout_constraintEnd_toEndOf="@id/cardMyAvatar"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/tvMyStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxWidth="100dp"
                                android:maxHeight="150sp"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Я тебя очень люблю d" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/tvMyName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/tiktokshrift"
                            android:maxWidth="100dp"
                            android:maxLines="1"
                            android:text="Я"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="@id/cardMyAvatar"
                            app:layout_constraintStart_toStartOf="@id/cardMyAvatar"
                            app:layout_constraintTop_toBottomOf="@id/cardMyAvatar" />


                        <!-- === ПРАВЫЙ ПОЛЬЗОВАТЕЛЬ (ПАРТНЕР) === -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardPartnerAvatar"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginStart="16dp"
                            app:cardBackgroundColor="@android:color/white"
                            app:cardCornerRadius="40dp"
                            app:cardElevation="2dp"
                            app:layout_constraintBottom_toBottomOf="@id/tvHeartIcon"
                            app:layout_constraintStart_toEndOf="@id/tvHeartIcon"
                            app:layout_constraintTop_toTopOf="@id/tvHeartIcon">

                            <ImageView
                                android:id="@+id/ivPartnerAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="20dp"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_input_add"
                                app:tint="@color/text_secondary" />
                        </androidx.cardview.widget.CardView>

                        <!-- Статус Партнера -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardPartnerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="-30dp"
                            android:layout_marginBottom="-4dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="6dp"
                            app:contentPadding="4dp"
                            app:layout_constraintBottom_toTopOf="@id/cardPartnerAvatar"
                            app:layout_constraintEnd_toEndOf="@id/cardPartnerAvatar"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/tvPartnerStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxWidth="100dp"
                                android:maxHeight="150sp"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Я тебя очень люблю" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/tvPartnerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/tiktokshrift"
                            android:maxWidth="100dp"
                            android:maxLines="1"
                            android:text="@string/invite"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="@id/cardPartnerAvatar"
                            app:layout_constraintStart_toStartOf="@id/cardPartnerAvatar"
                            app:layout_constraintTop_toBottomOf="@id/cardPartnerAvatar" />

                        <!-- КЛИКАБЕЛЬНАЯ ЗОНА ДЛЯ ПАРТНЕРА (Прозрачный слой) -->
                        <LinearLayout
                            android:id="@+id/layoutPartner"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="@id/tvPartnerName"
                            app:layout_constraintEnd_toEndOf="@id/cardPartnerAvatar"
                            app:layout_constraintStart_toStartOf="@id/cardPartnerAvatar"
                            app:layout_constraintTop_toTopOf="@id/cardPartnerAvatar" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- === ЗАПИСКА НА ХОЛОДИЛЬНИКЕ (НОВОЕ) === -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFridge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFF9C4"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_edit"
                                app:tint="#FBC02D" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="На холодильнике"
                                android:textColor="#FBC02D"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFridgeNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Оставьте записку для любимого человека..."
                            android:textColor="#5D4037"
                            android:textSize="18sp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>