<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_input_field"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="Установить статус"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Поле ввода текста -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCustomStatus"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_soft"
            android:hint="Напишите что-нибудь..."
            android:inputType="textCapSentences|textNoSuggestions"
            android:maxLength="20"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveStatus"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="@color/baby_pink"
            android:paddingHorizontal="20dp"
            android:text="OK"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Или выберите эмодзи:"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Сетка эмодзи -->
    <GridLayout
        android:id="@+id/gridStatuses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="6"
        android:rowCount="2"
        android:useDefaultMargins="false" />

    <Button
        android:id="@+id/btnClearStatus"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/baby_pink"
        android:text="Сбросить статус"
        android:textColor="@color/text_primary"
        android:textAllCaps="false"/>

</LinearLayout>