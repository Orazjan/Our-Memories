<resources>
    <!-- Base application theme for Night mode -->
    <style name="Base.Theme.OurMemories" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Основные цвета бренда -->
        <item name="colorPrimary">@color/primary_lavender</item>
        <item name="colorOnPrimary">#000000</item> <!-- Текст на кнопке Primary -->

        <!-- Фон всего приложения -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/white</item> <!-- Цвет карточек/диалогов -->
        <item name="colorOnSurface">@color/text_primary</item> <!-- Цвет текста на карточках -->
        <item name="colorOnBackground">@color/text_primary</item> <!-- Цвет текста на фоне -->

        <!-- Настройка текста по умолчанию -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.OurMemories" parent="Base.Theme.OurMemories" />

    <!-- Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.OurMemories</item>
    </style>

    <style name="Theme.OurMemories.NumberPicker" parent="Theme.AppCompat.Light">
        <!-- Цвет текста цифр -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <!-- Цвет горизонтальных линий-разделителей -->
        <item name="colorControlNormal">@color/baby_pink</item>
        <!-- Размер текста (опционально) -->
        <item name="android:textSize">18sp</item>
    </style>
</resources>
