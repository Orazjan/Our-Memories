<resources>
    <!-- Base application theme for Night mode -->
    <style name="Base.Theme.OurMemories" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/primary_lavender</item>
    </style>

    <style name="Theme.OurMemories" parent="Base.Theme.OurMemories" />

    <!-- Настройка Splash Screen для ночи -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Черный фон при запуске -->
        <item name="windowSplashScreenBackground">#121212</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>

        <item name="postSplashScreenTheme">@style/Theme.OurMemories</item>
    </style>

    <style name="CalendarDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalenderViewCustom" parent="Theme.AppCompat">
        <item name="colorAccent">@color/heart_red</item>
        <item name="colorPrimary">@color/heart_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>
</resources>